{
  "uid": "manutencao-preditiva",
  "title": "Manutenção preditiva 4.0",
  "schemaVersion": 39,
  "version": 1,
  "editable": false,
  "refresh": "15s",
  "time": {
    "from": "now-30m",
    "to": "now"
  },
  "tags": [
    "manutencao",
    "mlops"
  ],
  "timezone": "browser",
  "panels": [
    {
      "id": 1,
      "type": "table",
      "title": "Fila de manutenção (RUL + gravidade da OS)",
      "gridPos": {
        "x": 0,
        "y": 0,
        "w": 24,
        "h": 10
      },
      "datasource": {
        "type": "yesoreyeram-infinity-datasource",
        "uid": "infinity"
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "yesoreyeram-infinity-datasource",
            "uid": "infinity"
          },
          "type": "json",
          "parser": "backend",
          "source": "url",
          "format": "table",
          "url": "http://api:8000/prioridade",
          "url_options": {
            "method": "GET",
            "data": ""
          },
          "root_selector": "itens",
          "columns": [
            {
              "selector": "unit_id",
              "text": "Motor",
              "type": "number"
            },
            {
              "selector": "rul",
              "text": "RUL (ciclos)",
              "type": "number"
            },
            {
              "selector": "prioridade",
              "text": "Prioridade",
              "type": "number"
            },
            {
              "selector": "gravidade_os",
              "text": "Gravidade da OS",
              "type": "string"
            },
            {
              "selector": "critico",
              "text": "Crítico",
              "type": "boolean"
            }
          ]
        }
      ],
      "fieldConfig": {
        "defaults": {},
        "overrides": [
          {
            "matcher": {
              "id": "byName",
              "options": "Prioridade"
            },
            "properties": [
              {
                "id": "custom.cellOptions",
                "value": {
                  "type": "color-background"
                }
              },
              {
                "id": "thresholds",
                "value": {
                  "mode": "absolute",
                  "steps": [
                    {
                      "color": "green",
                      "value": null
                    },
                    {
                      "color": "yellow",
                      "value": 0.4
                    },
                    {
                      "color": "red",
                      "value": 0.7
                    }
                  ]
                }
              },
              {
                "id": "decimals",
                "value": 2
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "RUL (ciclos)"
            },
            "properties": [
              {
                "id": "decimals",
                "value": 0
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "Gravidade da OS"
            },
            "properties": [
              {
                "id": "custom.cellOptions",
                "value": {
                  "type": "color-text"
                }
              },
              {
                "id": "mappings",
                "value": [
                  {
                    "type": "value",
                    "options": {
                      "crítica": {
                        "color": "red",
                        "index": 0
                      },
                      "alta": {
                        "color": "orange",
                        "index": 1
                      },
                      "média": {
                        "color": "yellow",
                        "index": 2
                      },
                      "baixa": {
                        "color": "green",
                        "index": 3
                      }
                    }
                  }
                ]
              }
            ]
          }
        ]
      },
      "options": {
        "sortBy": [
          {
            "displayName": "Prioridade",
            "desc": true
          }
        ],
        "showHeader": true
      },
      "transformations": [
        {
          "id": "organize",
          "options": {
            "indexByName": {
              "Motor": 0,
              "RUL (ciclos)": 1,
              "Prioridade": 2,
              "Gravidade da OS": 3,
              "Crítico": 4
            }
          }
        }
      ]
    },
    {
      "id": 2,
      "type": "bargauge",
      "title": "RUL por motor (15 menores)",
      "gridPos": {
        "x": 0,
        "y": 10,
        "w": 12,
        "h": 10
      },
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "bottomk(15, mp_rul_ciclos)",
          "legendFormat": "Motor {{unit_id}}",
          "instant": true,
          "range": false
        }
      ],
      "fieldConfig": {
        "defaults": {
          "min": 0,
          "max": 125,
          "unit": "none",
          "decimals": 0,
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "red",
                "value": null
              },
              {
                "color": "orange",
                "value": 15
              },
              {
                "color": "yellow",
                "value": 40
              },
              {
                "color": "green",
                "value": 80
              }
            ]
          }
        },
        "overrides": []
      },
      "options": {
        "orientation": "horizontal",
        "displayMode": "gradient",
        "showUnfilled": true,
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "values": false
        }
      }
    },
    {
      "id": 3,
      "type": "timeseries",
      "title": "Drift por sensor (PSI, limiar 0,2)",
      "gridPos": {
        "x": 12,
        "y": 10,
        "w": 12,
        "h": 10
      },
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "mp_psi",
          "legendFormat": "{{sensor}}",
          "instant": false,
          "range": true
        }
      ],
      "fieldConfig": {
        "defaults": {
          "min": 0,
          "custom": {
            "thresholdsStyle": {
              "mode": "line"
            },
            "lineWidth": 2
          },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              },
              {
                "color": "red",
                "value": 0.2
              }
            ]
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "table",
          "placement": "right",
          "calcs": [
            "lastNotNull"
          ]
        }
      }
    },
    {
      "id": 4,
      "type": "state-timeline",
      "title": "Mapa de calor do PSI por sensor",
      "gridPos": {
        "x": 0,
        "y": 20,
        "w": 12,
        "h": 8
      },
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "mp_psi",
          "legendFormat": "{{sensor}}",
          "instant": false,
          "range": true
        }
      ],
      "fieldConfig": {
        "defaults": {
          "min": 0,
          "max": 0.4,
          "color": {
            "mode": "thresholds"
          },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              },
              {
                "color": "yellow",
                "value": 0.1
              },
              {
                "color": "red",
                "value": 0.2
              }
            ]
          },
          "custom": {
            "fillOpacity": 85
          }
        },
        "overrides": []
      },
      "options": {
        "showValue": "never",
        "rowHeight": 0.9,
        "mergeValues": false
      }
    },
    {
      "id": 5,
      "type": "piechart",
      "title": "Gravidade das OS triadas",
      "gridPos": {
        "x": 12,
        "y": 20,
        "w": 12,
        "h": 8
      },
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "sum by (gravidade) (mp_os_total)",
          "legendFormat": "{{gravidade}}",
          "instant": true,
          "range": false
        }
      ],
      "fieldConfig": {
        "defaults": {},
        "overrides": [
          {
            "matcher": {
              "id": "byName",
              "options": "crítica"
            },
            "properties": [
              {
                "id": "color",
                "value": {
                  "mode": "fixed",
                  "fixedColor": "red"
                }
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "alta"
            },
            "properties": [
              {
                "id": "color",
                "value": {
                  "mode": "fixed",
                  "fixedColor": "orange"
                }
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "média"
            },
            "properties": [
              {
                "id": "color",
                "value": {
                  "mode": "fixed",
                  "fixedColor": "yellow"
                }
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "baixa"
            },
            "properties": [
              {
                "id": "color",
                "value": {
                  "mode": "fixed",
                  "fixedColor": "green"
                }
              }
            ]
          }
        ]
      },
      "options": {
        "pieType": "donut",
        "legend": {
          "displayMode": "table",
          "placement": "right",
          "values": [
            "value"
          ]
        },
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "values": false
        }
      }
    },
    {
      "id": 6,
      "type": "timeseries",
      "title": "Latência p95 por rota",
      "gridPos": {
        "x": 0,
        "y": 28,
        "w": 8,
        "h": 8
      },
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "histogram_quantile(0.95, sum by (le, handler) (rate(http_request_duration_seconds_bucket[5m])))",
          "legendFormat": "{{handler}}",
          "instant": false,
          "range": true
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "s",
          "min": 0
        },
        "overrides": []
      }
    },
    {
      "id": 7,
      "type": "timeseries",
      "title": "Taxa de erro 5xx",
      "gridPos": {
        "x": 8,
        "y": 28,
        "w": 8,
        "h": 8
      },
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "sum(rate(http_request_duration_seconds_count{status=~\"5..\"}[5m]))",
          "legendFormat": "5xx/s",
          "instant": false,
          "range": true
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "reqps",
          "min": 0,
          "color": {
            "mode": "fixed",
            "fixedColor": "red"
          }
        },
        "overrides": []
      }
    },
    {
      "id": 8,
      "type": "stat",
      "title": "Drift: sensores e texto",
      "gridPos": {
        "x": 16,
        "y": 28,
        "w": 8,
        "h": 8
      },
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "mp_sensores_drift",
          "legendFormat": "Sensores com PSI > 0,2",
          "instant": true,
          "range": false
        },
        {
          "refId": "B",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "mp_texto_oov_taxa",
          "legendFormat": "Tokens fora do vocabulário",
          "instant": true,
          "range": false
        },
        {
          "refId": "C",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "mp_texto_psi_classes",
          "legendFormat": "PSI das classes de OS",
          "instant": true,
          "range": false
        }
      ],
      "fieldConfig": {
        "defaults": {
          "decimals": 2,
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              },
              {
                "color": "red",
                "value": 0.2
              }
            ]
          }
        },
        "overrides": [
          {
            "matcher": {
              "id": "byName",
              "options": "Sensores com PSI > 0,2"
            },
            "properties": [
              {
                "id": "decimals",
                "value": 0
              },
              {
                "id": "thresholds",
                "value": {
                  "mode": "absolute",
                  "steps": [
                    {
                      "color": "green",
                      "value": null
                    },
                    {
                      "color": "red",
                      "value": 4
                    }
                  ]
                }
              }
            ]
          }
        ]
      },
      "options": {
        "colorMode": "value",
        "textMode": "value_and_name",
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "values": false
        }
      }
    }
  ]
}
